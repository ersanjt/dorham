NODE_ENV=development
API_PORT=4000
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
API_PUBLIC_URL=http://localhost:4000
DATABASE_URL=postgresql://dorham:dorham@localhost:5432/dorham?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
API_PUBLIC_URL=http://localhost:4000
MEDIA_DIR=.media

# Sign-in with Google, Apple, and Facebook. Leave blank until the developer apps exist.
