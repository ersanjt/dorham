# Copy to .env at the repo root AND apps/api/.env for local API.

NODE_ENV=development
APP_NAME=Dorham
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PUBLIC_URL=http://localhost:4000
API_PORT=4000
MEDIA_DIR=.media

# Comma-separated browser origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

DATABASE_URL=postgresql://dorham:dorham@localhost:5432/dorham?schema=public
REDIS_URL=redis://localhost:6379

# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Object storage (Cloudflare R2 / S3) — later phases
S3_ENDPOINT=
S3_BUCKET=dorham-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto

# Email (Resend) — required in production for verify + password reset
# RESEND_API_KEY=re_xxx
# MAIL_FROM=Dorham <noreply@dorham.app>

# API bind (production behind tunnel)
# API_HOST=127.0.0.1

# Launch city lock
DEFAULT_CITY=istanbul
DEFAULT_COUNTRY=TR

# Web store links (optional until published)
# NEXT_PUBLIC_PLAY_STORE_URL=
# NEXT_PUBLIC_APP_STORE_URL=
# NEXT_PUBLIC_EXPO_URL=exp://192.168.1.111:8081

# --- Production (dorham.app) — see docs/09-deploy-cloudflare.md ---
# APP_URL=https://dorham.app
# API_PUBLIC_URL=https://api.dorham.app
# CORS_ORIGINS=https://dorham.app,https://www.dorham.app
# NEXT_PUBLIC_API_URL=https://api.dorham.app
# NEXT_PUBLIC_APP_URL=https://dorham.app
# EXPO_PUBLIC_API_URL=https://api.dorham.app
# EXPO_PUBLIC_WEB_URL=https://www.dorham.app
